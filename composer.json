{
  "name": "assignment/synthetic-payment-retry-api",
  "description": "Synthetic educational payment retry API for Assignment 2",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-redis": "*",
    "doctrine/orm": "^3.3",
    "guzzlehttp/guzzle": "^7.9",
    "slim/psr7": "^1.7",
    "slim/slim": "^4.14",
    "symfony/cache": "^7.3",
    "symfony/messenger": "^7.3",
    "symfony/redis-messenger": "^7.3",
    "zircote/swagger-php": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "scripts": {
    "openapi": "openapi src -o openapi.yaml"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {}
  }
}
